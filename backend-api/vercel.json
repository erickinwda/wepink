{
  "version": 2,
  "builds": [
    {
      "src": "api/*.php",
      "use": "@vercel/php"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    }
  ],
  "env": {
    "BUCK_BASE_URL": "@buck_base_url",
    "BUCK_ACCESS_TOKEN": "@buck_access_token",
    "BUCK_USER_AGENT": "@buck_user_agent",
    "BUCK_CLIENT_SECRET": "@buck_client_secret",
    "BUCK_WEBHOOK_SECRET": "@buck_webhook_secret",
    "BUCK_ENVIRONMENT": "@buck_environment",
    "BUCK_WEBHOOK_SIGNATURE_HEADER": "@buck_webhook_signature_header",
    "CHECKOUT_WEBHOOK_URL": "@checkout_webhook_url",
    "PIX_EXPIRATION_MINUTES": "@pix_expiration_minutes",
    "KIT_1_PRICE": "@kit_1_price",
    "KIT_2_PRICE": "@kit_2_price",
    "FB_PIXEL_ID": "@fb_pixel_id",
    "FB_ACCESS_TOKEN": "@fb_access_token",
    "FB_TEST_EVENT_CODE": "@fb_test_event_code",
    "CORS_ALLOWED_ORIGINS": "@cors_allowed_origins",
    "DATABASE_URL": "@database_url"
  }
}